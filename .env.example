NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cuadre: los pedidos de remesa de la calculadora se avisan también a la
# bandeja de Cuadre. La clave se genera en Cuadre → Ajustes → Generar clave, y
# solo se ve una vez.
#
# SIN prefijo NEXT_PUBLIC_ a propósito: Next manda al navegador todo lo que lo
# lleve, y quien tenga esta clave puede meter pedidos en Cuadre sin cuenta ni
# contraseña. La lee únicamente src/app/api/cuadre/route.ts, en el servidor.
#
# Sin ella la web funciona igual de bien: el pedido se guarda en `orders` y se
# pasa a Cuadre a mano.
CUADRE_API_KEY=
CUADRE_URL=https://cuadre.casavivadecuba.com

# Adaptador de catálogo Product Studio One / NEXO (ver src/lib/catalog).
# Sin NEXO_CATALOG_URL, la tienda queda en estado "not_configured" a
# propósito: no se inventan productos ni pedidos. Hoy el catálogo de
# energía se lee del endpoint público de solo lectura de NEXO (no requiere
# clave); NEXO_CATALOG_API_KEY queda preparada por si el otro lado exige
# autenticación en el futuro.
NEXO_CATALOG_URL=https://nexotienda.casavivadecuba.com/api/marketplace/products
NEXO_CATALOG_API_KEY=

# Solo desarrollo: pone "off" para probar la tienda en estado not_configured
# incluso en local (por defecto, fuera de producción se usan fixtures).
CUYANA_CATALOG_FIXTURES=
